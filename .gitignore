# Dependencies & build output
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment & secrets — only .env.example is committed
.env
.env.*
!.env.example
*.pem

# Local data — never commit databases or user uploads
*.db
*.db-journal
/storage/
apps/web/storage/
apps/web/public/uploads/

# Logs & OS noise
*.log
.DS_Store

# generated Dart client (CI / local check only)
/.dart-client/

# Server deployment (deploy/): filled-in settings and backups stay on the server
/deploy/server.env
/deploy/backups/

# Python bytecode (deploy/check-stack.py, scripts)
__pycache__/

# The demo account's photos and filled-in manifest (deploy/demo/README.md):
# the photos may show real clothes
/deploy/demo/photos/
/deploy/demo/manifest.json

# ATLAS environment template. Copy to `.env` (Docker Compose, repo root) or
# `apps/web/.env` (running `bun run dev` directly). Never commit real values.

# ── Database ────────────────────────────────────────────────────────────────
# Used by docker-compose.yml to create and connect to Postgres.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-local-only
# Used when running the app outside Docker (bun run dev / prisma migrate).
DATABASE_URL=postgresql://atlas:change-me-local-only@localhost:5432/atlas

# ── Secrets (required — the server refuses to start without them) ──────────
# Each must be ≥ 32 characters and different. Generate with:
#   openssl rand -base64 48
# (Refresh tokens are opaque random values stored hashed in Postgres, so there
# is no separate refresh secret any more.)
JWT_SECRET=
MEDIA_SIGNING_SECRET=
# Encrypts the successor refresh token kept for 60 s after a rotation (so a
# retried or concurrent refresh gets the same new token). Exactly 32 random
# bytes, base64, independent of every other secret:
#   openssl rand -base64 32
SESSION_ENC_KEY=
# Staged key rotation (optional, decrypt only, comma-separated, at most 2):
# 1) add the new key here on every instance; 2) make it SESSION_ENC_KEY and
# move the old one here; 3) remove the old key after a few minutes.
# SESSION_ENC_DECRYPT_KEYS=

# ── Sessions ────────────────────────────────────────────────────────────────
# Access JWT lifetime (atlas_at cookie), seconds. Default 900 (15 min), min 10.
# ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime without use, days. Default 30. Every login is also
# capped at 90 days in total (absolute limit, not configurable).
# REFRESH_TOKEN_TTL_DAYS=30
# Auth cookies are `Secure` when NODE_ENV=production. Set COOKIE_SECURE=0 ONLY
# for plain-http local Docker/e2e on a non-localhost host; never in real
# deployments. (Browsers accept Secure cookies on http://localhost anyway.)
# COOKIE_SECURE=

# ── Image storage ───────────────────────────────────────────────────────────
# Only "local" is implemented. Files are private and served via signed URLs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
MEDIA_URL_TTL_SECONDS=3600
# Public origin for ABSOLUTE image URLs (needed by the mobile app), e.g.
# https://api.atlas.example — origin only, https in production. Never taken
# from the request's Host header. Unset: relative URLs (web only).
# PUBLIC_BASE_URL=

# ── External providers ──────────────────────────────────────────────────────
# open-meteo (default) | mock. Check Open-Meteo's terms before commercial launch.
WEATHER_PROVIDER=open-meteo

# ── AI providers (docs/ai/provider-architecture.md) ─────────────────────────
# Text AI (stylist, outfit explanation): mock | gemini | openai. Development
# defaults to mock. Production REFUSES to start with mock, or with a real
# provider whose key or model is missing. No winner is selected yet: gemini and
# openai are candidates for the Phase 4 bake-off; the model id is explicit.
AI_LLM_PROVIDER=
# AI_LLM_MODEL=
# Keys are server-side only (never in the mobile app, never committed):
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Per-attempt timeout in ms (1000–55000, default 25000). One retry at most,
# only for timeouts, network errors, 429 and 500/502/503/504.
# AI_LLM_TIMEOUT_MS=25000
# Optional prices (USD per million tokens) for cost estimates in ai.call logs.
# AI_LLM_PRICE_INPUT_USD_PER_MTOK=
# AI_LLM_PRICE_OUTPUT_USD_PER_MTOK=
# Clothing analysis: only "mock" until real vision (Phase 4.1).
AI_VISION_PROVIDER=mock
# Clothing analysis is still the mock, so until Phase 4.1 a production build
# needs this explicit acknowledgement (also used by local Docker and e2e).
# Never set it for a real deployment once a real provider exists.
# AI_ALLOW_MOCK_IN_PRODUCTION=1

# ── Operations ──────────────────────────────────────────────────────────────
# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For;
# enables per-IP rate limits on auth endpoints.
TRUST_PROXY=0
# Set to 1 to log SQL queries (may include user data — debugging only).
PRISMA_LOG_QUERIES=0

# Lookly on your own machine with Docker Compose (docker-compose.yml).
# Copy to `.env` in the repository root and fill in the empty values. Never
# commit real values. A server uses deploy/server.env instead
# (deploy/server.env.example, docs/deploy/staging.md). The Go server reads and
# checks every variable at start and names any it refuses
# (apps/api/internal/config; apps/api/README.md runs it without Docker).

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=atlas
POSTGRES_USER=atlas
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Secrets (required; each different) ──────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
MEDIA_SIGNING_SECRET=
# Encrypts the successor refresh token kept for 60 s after a rotation. Exactly
# 32 random bytes:  openssl rand -base64 32
SESSION_ENC_KEY=
# Staged rotation of SESSION_ENC_KEY (optional, decrypt only, at most 2,
# comma-separated): add the new key here everywhere, make it SESSION_ENC_KEY
# and move the old one here, remove the old one after a few minutes.
# SESSION_ENC_DECRYPT_KEYS=

# ── Server ──────────────────────────────────────────────────────────────────
# development (here) | staging | production (servers). development allows the
# mock AI and writes reset e-mails to files instead of sending them.
LOOKLY_ENV=development
# debug | info | warn | error. JSON lines; tokens, passwords and prompts are
# never logged.
# LOOKLY_LOG_LEVEL=info
# Time to finish running requests and jobs on a stop (default 20s; Compose
# gives the containers 25 s) and the database connections per process.
# LOOKLY_SHUTDOWN_GRACE=20s
# LOOKLY_DB_MAX_CONNS=
# Access token lifetime in seconds (default 900) and refresh token lifetime
# without use in days (default 30; every sign-in ends after 90 days at most).
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# ── Images ──────────────────────────────────────────────────────────────────
# local (the uploads volume) | r2 (a Cloudflare R2 bucket: set the five R2_*).
# STORAGE_DRIVER=local
# R2_ENDPOINT=
# R2_REGION=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Lifetime of a signed image link, seconds (default 3600).
# MEDIA_URL_TTL_SECONDS=3600
# The most orphaned files one sweep may remove; more stops it for a person to
# look (docs/architecture/backend.md).
# STORAGE_SWEEP_MAX_REMOVALS=

# ── E-mail: password reset links ────────────────────────────────────────────
# Unset here: each message is a JSON file in the mail-outbox volume. smtp sends
# it (any provider; port 587 needs STARTTLS, 465 needs SMTP_SECURE=1);
# disabled turns "forgot password" off.
# MAIL_TRANSPORT=
# MAIL_FROM=Lookly <no-reply@example.uz>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASSWORD=

# ── Weather ─────────────────────────────────────────────────────────────────
# open-meteo (default) | mock. Check Open-Meteo's terms before commercial launch.
# WEATHER_PROVIDER=open-meteo

# ── AI (docs/ai/provider-architecture.md) ───────────────────────────────────
# Unset here: the mock providers, no key, no cost. A real provider (gemini |
# openai) needs its key and an explicit model; outside development the mock is
# refused unless AI_ALLOW_MOCK_IN_PRODUCTION=1 says so.
# AI_LLM_PROVIDER=mock
# AI_LLM_MODEL=
# AI_VISION_PROVIDER=mock
# AI_VISION_MODEL=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Per-feature text routes (set both of a pair or neither) and the providers
# any role may use:
# AI_STYLIST_PROVIDER=
# AI_STYLIST_MODEL=
# AI_OUTFIT_PROVIDER=
# AI_OUTFIT_MODEL=
# AI_APPROVED_PROVIDERS=
# Per-attempt time limits (ms), the picture sent for analysis, and prices for
# the cost estimates in the logs (USD per million tokens, both of a pair):
# AI_LLM_TIMEOUT_MS=25000
# AI_VISION_TIMEOUT_MS=15000
# AI_VISION_MAX_SIDE=1024
# AI_VISION_RESOLUTION=high
# AI_VISION_GEMINI_THINKING_LEVEL=low
# AI_VISION_DETAIL=high
# AI_LLM_PRICE_INPUT_USD_PER_MTOK=
# AI_LLM_PRICE_OUTPUT_USD_PER_MTOK=
# AI_VISION_PRICE_INPUT_USD_PER_MTOK=
# AI_VISION_PRICE_OUTPUT_USD_PER_MTOK=
# Rollout (docs/ai/rollout.md): on here; in staging and production a missing
# value is OFF. Allowlist entries are digests, never raw user ids.
# AI_STYLIST_ENABLED=true
# AI_VISION_ENABLED=true
# AI_OUTFIT_AI_ENABLED=true
# AI_ROLLOUT_PERCENT=100
# AI_ROLLOUT_ALLOWLIST=

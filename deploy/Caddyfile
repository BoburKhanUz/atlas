# The one entry point (docker-compose.yml): /api and /api/* go to the Go server,
# everything else to the website. SITE_ADDRESS is ":80" locally (plain http) and
# the domain on a server (deploy/compose.server.yml), where Caddy obtains and
# renews the certificate: the domain's DNS A record must point at the server and
# ports 80 and 443 must be reachable. HSTS is set here, where HTTPS ends;
# browsers ignore it over plain http. The other security headers are the
# apps' own (apps/api/internal/httpapi, apps/web/next.config.ts).
{$SITE_ADDRESS} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	@api path /api /api/*
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}

# Lookly server settings for deploy/compose.server.yml (staging shown).
# Copy to deploy/server.env on the server (git-ignored), fill in every empty
# value, then `chmod 600 deploy/server.env`. Never commit the filled-in file.
# Runbook: docs/deploy/staging.md. Variable reference: .env.example.

# ── Server ──────────────────────────────────────────────────────────────────
# staging | production (deploy/compose.sh refuses anything else). Both refuse a
# missing secret, the mock AI and test mail.
LOOKLY_ENV=staging

# ── Public address ──────────────────────────────────────────────────────────
# Host name only (no https://, no path). Its DNS A record must point here. The
# one address serves the website and the API (/api/*), as lookly.uz will.
ATLAS_DOMAIN=staging.example.com

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=atlas
POSTGRES_USER=atlas
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Secrets (each different; the server refuses to start without them) ─────
# Generate them on the server; never paste them into a chat or a ticket.
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 48
MEDIA_SIGNING_SECRET=
# openssl rand -base64 32   (exactly 32 bytes)
SESSION_ENC_KEY=

# ── AI: OpenAI only (owner decision 2026-11-27) ─────────────────────────────
# The app has no minimum age, and Gemini's terms forbid apps likely to be used
# by people under 18, so production asks OpenAI for text (stylist, outfit
# explanation) and clothing photos. The text model is the one the stage B6
# live smoke checked; choosing it for good follows the stylist evaluation
# (docs/ai/stylist-evaluation.md). The key comes from a billing-enabled account
# with a spending limit set at the provider.
AI_APPROVED_PROVIDERS=openai
AI_LLM_PROVIDER=openai
AI_LLM_MODEL=gpt-5.4-mini
AI_VISION_PROVIDER=openai
AI_VISION_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# Prices for the cost estimates in ai.call logs, USD per million tokens, from
# https://developers.openai.com/api/docs/pricing (checked 2026-11-28).
AI_LLM_PRICE_INPUT_USD_PER_MTOK=0.75
AI_LLM_PRICE_OUTPUT_USD_PER_MTOK=4.50
AI_VISION_PRICE_INPUT_USD_PER_MTOK=0.75
AI_VISION_PRICE_OUTPUT_USD_PER_MTOK=4.50

# ── Rollout (docs/ai/rollout.md) ────────────────────────────────────────────
# Staging: every feature on for every account. A production build treats a
# missing value as OFF, so production sets these deliberately.
AI_STYLIST_ENABLED=true
AI_VISION_ENABLED=true
AI_OUTFIT_AI_ENABLED=true
AI_ROLLOUT_PERCENT=100

# ── E-mail: password reset links ────────────────────────────────────────────
# Any SMTP provider (the domain's own mailbox, Yandex 360, Google Workspace…).
# Keep MAIL_TRANSPORT=disabled until the values below are filled in: with
# smtp and an empty SMTP_HOST the server refuses to start. Disabled, "forgot
# password" tells users that reset is unavailable for now.
MAIL_TRANSPORT=disabled
SMTP_HOST=
# 587 = STARTTLS (required); 465 = TLS from the start (then SMTP_SECURE=1)
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Lookly <no-reply@example.uz>

# ── Images ──────────────────────────────────────────────────────────────────
# local: the uploads volume on this server (deploy/backup.sh copies it).
# r2: a Cloudflare R2 bucket; set the five R2_* (docs/architecture/media.md).
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_REGION=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Other ───────────────────────────────────────────────────────────────────
WEATHER_PROVIDER=open-meteo
LOOKLY_LOG_LEVEL=info
